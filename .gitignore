
# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Generated machine-learning models
models/*.joblib
models/*.pkl
models/*.pickle

# Generated outputs
outputs/*
!outputs/.gitkeep

# Dataset files: large or licensed datasets should not be committed blindly
data/*
!data/.gitkeep

# Keep directories visible in Git
!images/.gitkeep
